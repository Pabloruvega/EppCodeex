# Copiá este archivo a .env y completá los valores.
# En Vercel: `vercel env pull .env` trae DATABASE_URL desde la integración de Neon.
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Mínimo 8 caracteres
ADMIN_PASSWORD=
# Mínimo 32 caracteres. Generalo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
